{
  "name": "hunter-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "npm run typecheck && npm run prisma:migrate:status && npm run build",
    "env:check": "node scripts/validate-production-env.mjs",
    "lint": "next lint",
    "prisma:generate": "prisma generate --schema ./src/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema ./src/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ./src/prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema ./src/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@tailwindcss/postcss": "^4.2.2",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^3.0.3",
    "next": "^15.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.58.2"
  }
}
